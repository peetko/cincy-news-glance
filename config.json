    {"label": "City staff", "weight": 4, "terms": ["assistant city manager", "John Brazina", "Billy Weber", "Cathy Bailey", "budget director", "Andrew Dudas", "finance director", "Steve Webb", "city solicitor", "police chief", "fire chief", "city administration", "city employees", "city workers", "city staff", "city department"]},
